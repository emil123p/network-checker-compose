[Unit]
Description=Check and deploy Network Checker Compose updates
OnFailure=network-checker-notify-failure.service
Wants=network-online.target
After=network-online.target snap.docker.dockerd.service

[Service]
Type=oneshot
User=emil-paziuk
Environment=HOME=/home/emil-paziuk
WorkingDirectory=/home/emil-paziuk/network-checker-compose
ExecStart=/home/emil-paziuk/network-checker-compose/deploy-update.sh
